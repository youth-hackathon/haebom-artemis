# 이 파일을 relay/.env 로 복사하고 자기 키를 넣는다. relay/.env 는 git에 들어가지 않는다.
#   cp relay/.env.example relay/.env
# 값은 따옴표 없이 = 바로 뒤에 적는다. 키는 어디에도 출력하거나 커밋하지 않는다.

# 자기 Letsur 키. 이것 하나면 된다. 모델 호출은 https://gw.letsur.ai/v1 로 바로 간다.
LETSUR_API_KEY=

# (선택) Letsur 키를 가진 Cloudflare AI Gateway를 거쳐 부를 때. LETSUR_API_KEY가 비어 있을 때만 쓴다.
#   LETSUR_GATEWAY_URL  그 게이트웨이의 Letsur 경로. /v1/responses 로 끝난다
#   AI_GATEWAY_TOKEN    그 게이트웨이의 실행 토큰
LETSUR_GATEWAY_URL=
AI_GATEWAY_TOKEN=

# (선택) GUIDE_PROFILE=haiku 로 띄울 때만.
ANTHROPIC_API_KEY=

# (선택) jev 방식으로 답할 때만. Jev(TypeSafe)를 OpenRouter로 부르는 자기 OpenRouter 키.
OPENROUTER_API_KEY=
